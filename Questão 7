<?php

$valor = readline("Digite o valor da compra: ");

if ($valor > 500) {
    $desconto = $valor * 0.20;
} elseif ($valor > 100) {
    $desconto = $valor * 0.10;
} else {
    $desconto = 0;
}

$valorFinal = $valor - $desconto;

echo "Desconto: R$ " . number_format($desconto, 2, ',', '.') . "\n";
echo "Valor final: R$ " . number_format($valorFinal, 2, ',', '.') . "\n";
?>
